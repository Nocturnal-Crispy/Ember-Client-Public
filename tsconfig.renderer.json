{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "outDir": "./public/src/js",
    "rootDir": "./src/renderer",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src/renderer/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "src/renderer/services/crypto-service.ts",
    "src/renderer/types/auth.ts",
    "src/renderer/types/ember.ts",
    "src/renderer/types/message.ts",
    "src/renderer/types/voice.ts"
  ]
}
