{
  "name": "ember-client",
  "version": "0.0.14",
  "description": "Ember Client",
  "main": "public/src/js/main.js",
  "scripts": {
    "build": "npm run build:shared && tsc",
    "build:shared": "cd ../ember-shared && npm install && npm run build && cd -",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "test": "jest --config ./tests/jest.config.ts"
  },
  "keywords": [
    "typescript",
    "electron",
    "gui"
  ],
  "author": {
    "name": "Michael Crispen",
    "email": "mcrispen@crispywebservices.com"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/electron-store": "^3.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "ember-shared": "file:../ember-shared",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "build": {
    "appId": "com.ember.client",
    "productName": "Ember",
    "directories": {
      "output": "release"
    },
    "files": [
      "public/src/js/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "icon": "build/icons/512x512.png",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icons"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png"
    },
    "protocols": [
      {
        "name": "Ember",
        "schemes": [
          "ember"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
