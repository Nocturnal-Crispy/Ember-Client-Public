{
  "name": "ember-client",
  "version": "0.2.0",
  "description": "Ember Client",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:shared && npm run inject-key && tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && cp -r src/renderer/*.html dist/renderer/ && cp -r src/renderer/styles dist/renderer/ && mkdir -p dist/renderer/assets/icons && cp -r assets/icons/* dist/renderer/assets/icons/",
    "build:shared": "cd ember-shared && npm install && npm run build && cd .. && mkdir -p node_modules/ember-shared && cp -r ember-shared/dist/. node_modules/ember-shared/dist/ && cp -r ember-shared/package.json node_modules/ember-shared/",
    "inject-key": "./scripts/secure-build.sh --inject-only",
    "secure-build": "./scripts/secure-build.sh",
    "start": "npm run build && electron .",
    "dev": "NODE_ENV=development npm run build && electron .",
    "dev:watch": "NODE_ENV=development npm run build && electron .",
    "dist": "npm run secure-build && electron-builder",
    "dist:linux": "npm run secure-build && electron-builder --linux",
    "dist:win": "npm run secure-build && electron-builder --win",
    "dist:mac": "npm run secure-build && electron-builder --mac",
    "pretest": "npm rebuild better-sqlite3",
    "test": "jest --config ./tests/jest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install",
    "test:e2e:report": "playwright show-report test-results-report",
    "test:all": "npm run test && npm run test:e2e",
    "release": "npm run build && ./scripts/release.sh",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3,windows-audio-capture,linux-audio-capture"
  },
  "keywords": [
    "typescript",
    "electron",
    "gui"
  ],
  "author": {
    "name": "Michael Crispen",
    "email": "mcrispen@crispywebservices.com"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/electron-store": "^3.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@signalapp/libsignal-client": "^0.89.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.8.0",
    "electron-store": "^8.1.0",
    "ember-shared": "file:./ember-shared"
  },
  "build": {
    "appId": "com.ember.client",
    "productName": "Ember",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "icon": "assets/icons/512x512.png",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icons"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.png"
    },
    "protocols": [
      {
        "name": "Ember",
        "schemes": [
          "ember"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
