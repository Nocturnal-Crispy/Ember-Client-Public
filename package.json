{
  "name": "ember-client",
  "version": "0.2.5",
  "description": "Ember Client",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run inject-key && tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && cp -r src/renderer/*.html dist/renderer/ && cp -r src/renderer/styles dist/renderer/ && mkdir -p dist/renderer/assets/icons && cp -r assets/icons/* dist/renderer/assets/icons/ && cp -f assets/Luffy.jpg dist/renderer/assets/Luffy.jpg",
    "inject-key": "./scripts/secure-build.sh --inject-only",
    "secure-build": "./scripts/secure-build.sh",
    "prestart": "electron-rebuild -f -w better-sqlite3",
    "start": "npm run build && electron .",
    "dev": "npm run prestart && NODE_ENV=development npm run build && electron .",
    "dev:watch": "npm run prestart && NODE_ENV=development npm run build && electron .",
    "dist": "npm run secure-build && electron-builder",
    "dist:linux": "npm run secure-build && electron-builder --linux",
    "dist:win": "npm run secure-build && electron-builder --win",
    "dist:mac": "npm run secure-build && electron-builder --mac",
    "pretest": "npm rebuild better-sqlite3",
    "test": "node --max-old-space-size=4096 node_modules/.bin/jest --config ./tests/jest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install",
    "test:e2e:report": "playwright show-report test-results-report",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "lint:check": "eslint . --ext .ts,.js",
    "format": "eslint . --ext .ts,.js --fix",
    "format:check": "eslint . --ext .ts,.js",
    "release": "npm run build && ./scripts/release.sh",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "keywords": [
    "typescript",
    "electron",
    "gui"
  ],
  "author": {
    "name": "Michael Crispen",
    "email": "mcrispen@crispywebservices.com"
  },
  "license": "ISC",
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.18.0",
    "@types/electron-store": "^3.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^15.14.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@signalapp/libsignal-client": "^0.89.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.8.0",
    "electron-store": "^8.1.0",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.ember.client",
    "productName": "Ember",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "npmRebuild": false,
    "beforePack": "./scripts/rebuild-native.js",
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/@signalapp/libsignal-client/**"
    ],
    "icon": "assets/icons/512x512.png",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icons"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.png"
    },
    "protocols": [
      {
        "name": "Ember",
        "schemes": [
          "ember"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
